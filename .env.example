# URL de base de l'API utilisée par l'application (inclure le préfixe /api/v1)
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Active le mode API mockée pour éviter les erreurs réseau quand le backend n'est pas démarré
# Laisser sur "false" pour forcer l'utilisation de MySQL et des données réelles
VITE_USE_MOCK_API=false

# Mot de passe en clair correspondant aux hash configurés dans la base de données MySQL
# Remplacez cette valeur pour qu'elle corresponde au mot de passe ayant servi à générer les hash des comptes de démonstration
VITE_DEMO_PASSWORD=changeme

# Configuration backend Node.js/Express
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MySQL (utilisateur root sans mot de passe)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mfeats_app

# JWT multi-rôles
JWT_SECRET=change-me-secret
JWT_EXPIRES_IN=2h
DEFAULT_USER_PASSWORD=changeme

# Intégrations paiement (placeholders)
WAVE_API_KEY=demo-wave-key
ORANGE_MONEY_API_KEY=demo-orange-key

# Cache & notifications
REDIS_URL=
SOCKET_ALLOW_ORIGIN=*

# Fichiers & uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=5mb
